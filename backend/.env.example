# Le impostazioni vengono lette dalle variabili d'ambiente, non automaticamente da questo file.
SMT_MODE=demo
SMT_REGION=eu-south-1
SMT_PUBLIC_URL=http://localhost:8000
SMT_FRONTEND_URL=http://localhost:5173
# Solo per la futura configurazione AWS, tramite parametri/segreti del runtime:
# SMT_CORE_TABLE=
# SMT_EVENTS_TABLE=
# SMT_COGNITO_ISSUER=
# SMT_COGNITO_CLIENT_ID=
# SMT_CURSOR_SECRET=
# SMT_CURSOR_SECRET_PARAMETER=/scale-mobili-prototype/cursor-secret
# SMT_PHOTOS_BUCKET=
# SMT_SOURCES_BUCKET=
# SMT_COGNITO_DOMAIN=
# SMT_ADDITIONAL_CLIENT_IDS=[]
# SMT_WRITE_LIMIT_PER_MINUTE=20
# Per emulatori persistenti nel cloud, scegliere SMT_MODE=local e configurare:
# SMT_DYNAMODB_ENDPOINT=http://127.0.0.1:8001
# SMT_S3_ENDPOINT=http://127.0.0.1:9000
# SMT_CORE_TABLE=smt-local-core
# SMT_EVENTS_TABLE=smt-local-events
# SMT_PHOTOS_BUCKET=smt-local-photos
# SMT_SOURCES_BUCKET=smt-local-sources
# SMT_CURSOR_SECRET=local-only-cursors-at-least-32-characters
